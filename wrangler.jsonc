// Cloudflare Workers Builds: repo root, build command "npm run build", deploy "npx wrangler deploy", branch main.
// Secrets (dashboard, never here): RESEND_API_KEY. Vars below are filled when the domain exists.
{
  "name": "lune-site",
  "compatibility_date": "2026-10-08",
  "main": "worker/index.js",
  "workers_dev": true,
  "routes": [{ "pattern": "lunerituals.app", "custom_domain": true }, { "pattern": "www.lunerituals.app", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [{ "name": "WAITLIST_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "RESEND_AUDIENCE_ID": "",
    "WAITLIST_TO": "",
    "EMAIL_FROM": ""
  }
}
