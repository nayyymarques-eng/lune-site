---
// "Tonight" card, the moon compass: the live moon (sign + phase) and, from a birth date, time and place,
// the house of her chart it falls in tonight. Rendered at build time, then refreshed in the browser.
import moon from '../data/moon.json';
import R from '../data/readings.json';
import { signAt, phaseAt, cycleAt, cap } from '../lib/moon';
const now = Date.now();
const s = signAt(moon as any, now);
const p = phaseAt(moon as any, now);
const reading = (R.phases as any)[p.kind];
const cyc = cycleAt(moon as any, now);
---
<div class="tonight glass" data-tonight>
  <div class="wash" aria-hidden="true"></div>
  <div class="row">
    <span class="label"><span class="dot"></span>Tonight</span>
    <span class="label" data-t="until"></span>
  </div>
  <div class="tmoon"><canvas data-light="moon" data-size="340" data-phase={cyc.toFixed(3)} data-t="moon" aria-label="Tonight's moon, drawn in points of light"></canvas></div>
  <h2 class="ttitle"><span data-t="phase">{reading.name}</span> in <span data-t="sign">{cap(s.sign)}</span></h2>
  <p class="tline" data-t="line">{reading.reading}, with {(R.signs as any)[s.sign].tone}</p>
  <form class="pick" data-t="form" autocomplete="off" novalidate>
    <p class="label">Where does it fall in your chart?</p>
    <p class="small muted intro">Your birth date, time and place set your rising sign, and from it your twelve houses. Tonight's moon lands in one of them.</p>
    <div class="fields">
      <label class="field"><span class="label">Birth date</span><input type="date" required data-t="bdate" min="1920-01-01" max="2026-12-31" /></label>
      <label class="field"><span class="label">Birth time</span><input type="time" data-t="btime" /></label>
      <label class="nt"><input type="checkbox" data-t="notime" /> <span class="small">I don't know my birth time</span></label>
      <div class="field place">
        <label class="label" for="bplace">Birth place</label>
        <input id="bplace" type="text" required placeholder="Start typing a city" data-t="bplace" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="bplace-list" />
        <ul class="sugg" id="bplace-list" role="listbox" data-t="sugg" hidden></ul>
      </div>
    </div>
    <p class="err small" data-t="err" role="alert" hidden></p>
    <button class="btn primary" type="submit" data-t="go">Find my moon</button>
    <p class="small muted priv">Your birth details stay in this browser and are never stored. Only the city name you type is sent to Open-Meteo to find its coordinates.</p>
    <div class="yours" data-t="yours" hidden>
      <div class="ycard glass">
        <div class="wheel" aria-hidden="true">
          <svg viewBox="0 0 160 160" data-t="wheel"></svg>
          <div class="wnum"><span data-t="hnum">9th</span><small>house</small></div>
        </div>
        <div class="facts">
          <div><span class="label">Moon in</span><b data-t="fsign"></b></div>
          <div><span class="label">Your house</span><b data-t="fhouse"></b></div>
          <div><span class="label">Touches</span><b data-t="farea"></b></div>
        </div>
      </div>
      <div class="chart">
        <div><span class="label">Your rising</span><b data-t="rising"></b></div>
        <div><span class="label">Your sun</span><b data-t="sun"></b></div>
        <div><span class="label">Your moon</span><b data-t="nmoon"></b></div>
      </div>
      <p class="ytext" data-t="house"></p>
      <p class="small muted" data-t="how"></p>
      <div class="ptease glass">
        <canvas data-light="build" data-size="56" data-color="240 169 124" aria-hidden="true"></canvas>
        <div><span class="label">Your ritual for tonight</span><b data-t="pname"></b><span class="small muted">Step by step, with where it comes from and why it matters</span></div>
        <svg class="lock" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </div>
      <p class="small muted center">It opens in the app. Join the list and be the first to receive it.</p>
    </div>
  </form>
</div>
<script type="application/json" id="lune-readings" set:html={JSON.stringify({ phases: R.phases, signs: R.signs, houses: R.houses })} />

<style>
  .tonight { --c: 179 166 242; position: relative; overflow: hidden; padding: 24px; display: grid; gap: 16px; max-width: 480px; width: 100%; margin-inline: auto; }
  .wash { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(110% 60% at 50% 30%, rgb(var(--c) / .30), rgb(var(--c) / .10) 50%, transparent 85%); }
  .tonight > :not(.wash) { position: relative; min-width: 0; }
  .row { display: flex; justify-content: space-between; }
  .row .label { display: flex; align-items: center; gap: 8px; }
  .tmoon { width: min(340px, 100%); aspect-ratio: 1; margin: -24px auto -32px; }
  .tmoon canvas { width: 100%; height: 100%; display: block; }
  .ttitle { font: var(--text-title); letter-spacing: -0.035em; text-align: center; color: var(--foreground); }
  .tline { margin: 0; text-align: center; font: var(--text-body); color: var(--muted-foreground); }
  .pick { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 16px; }
  .pick .label { margin: 0; }
  .intro { margin: -8px 0 0 !important; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field { display: grid; gap: 6px; min-width: 0; }
  .field .label { margin: 0; }
  .field input { height: 48px; padding: 0 14px; border-radius: var(--radius-button); background: var(--glass-fill); border: 1px solid var(--glass-edge);
    color: var(--foreground); font: var(--text-body); color-scheme: dark; min-width: 0; width: 100%; box-sizing: border-box; }
  .field input:focus { outline: 2px solid rgb(179 166 242 / .7); outline-offset: 1px; }
  .field input:disabled { opacity: .4; }
  .nt { grid-column: 1 / -1; display: flex; gap: 8px; align-items: center; color: var(--muted-foreground); cursor: pointer; margin-top: -4px; }
  .nt input { accent-color: #fff; }
  .place { grid-column: 1 / -1; position: relative; }
  .sugg { position: absolute; z-index: 5; top: 100%; left: 0; right: 0; margin: 6px 0 0; padding: 6px; list-style: none; border-radius: 12px; background: #141418; border: 1px solid var(--glass-edge); box-shadow: 0 16px 40px rgb(0 0 0 / .6); display: grid; gap: 2px; }
  .sugg[hidden] { display: none; }
  .sugg :global(li) { padding: 10px 12px; border-radius: 8px; cursor: pointer; font: var(--text-body); color: var(--foreground); }
  .sugg :global(li small) { color: var(--muted-foreground); margin-left: 6px; }
  .sugg :global(li[aria-selected="true"]), .sugg :global(li:hover) { background: var(--glass-selected); }
  .pick .btn { width: 100%; }
  .err { margin: 0 !important; color: var(--destructive); }
  .err[hidden] { display: none; }
  .priv { margin: 0 !important; text-align: center; }
  .chart { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .chart div { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; background: var(--glass-fill); border: 1px solid var(--glass-edge); min-width: 0; }
  .chart b { font: var(--text-title); font-size: 16px; font-weight: 400; color: var(--foreground); }
  .yours { display: grid; gap: 12px; }
  .ycard { display: grid; grid-template-columns: 132px 1fr; gap: 16px; align-items: center; padding: 16px; border-radius: 16px; }
  .wheel { position: relative; width: 132px; aspect-ratio: 1; }
  .wheel svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .wnum { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .wnum span { font: var(--text-title); letter-spacing: -0.02em; color: var(--foreground); }
  .wnum small { font: var(--text-label); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); }
  .facts { display: grid; gap: 10px; }
  .facts div { display: grid; gap: 2px; }
  .facts b { font: var(--text-title); font-size: 16px; font-weight: 400; letter-spacing: -0.02em; color: var(--foreground); }
  .ytext { font: 400 17px/1.5 var(--font-sans) !important; color: var(--foreground); }
  .ptease { display: grid; grid-template-columns: 56px 1fr 20px; gap: 12px; align-items: center; padding: 12px 16px 12px 12px; border-radius: 16px; }
  .ptease canvas { width: 56px; height: 56px; }
  .ptease div { display: grid; gap: 2px; }
  .ptease b { font: var(--text-title); font-size: 16px; font-weight: 400; color: var(--foreground); }
  .lock { width: 20px; color: var(--muted-foreground); }
  .center { text-align: center; margin-top: 4px !important; }
  .yours[hidden] { display: none; }
  .yours p { margin: 0; }
</style>

<script>
  import * as A from 'astronomy-engine';
  import moon from '../data/moon.json';
  import { signAt, phaseAt, cycleAt, cap, SIGNS } from '../lib/moon';
  const R = JSON.parse(document.getElementById('lune-readings')!.textContent!);
  const root = document.querySelector('[data-tonight]') as HTMLElement;
  const $ = (k: string) => root.querySelector(`[data-t="${k}"]`) as any;
  const s = signAt(moon as any);
  const p = phaseAt(moon as any);
  $('phase').textContent = R.phases[p.kind].name;
  $('sign').textContent = cap(s.sign);
  $('line').textContent = `${R.phases[p.kind].reading}, with ${R.signs[s.sign].tone}`;
  $('moon').dataset.phase = cycleAt(moon as any).toFixed(3);
  if (s.until) $('until').textContent = 'until ' + new Date(s.until).toLocaleDateString('en-US', { weekday: 'short', hour: 'numeric' });

  // Same chart maths as the app (src/astro/chart.ts): whole-sign houses from the rising sign,
  // or from the Sun sign when the birth time is unknown.
  const norm = (d: number) => ((d % 360) + 360) % 360;
  const signOf = (lon: number) => SIGNS[Math.floor(norm(lon) / 30)];
  const moonLon = (d: Date) => A.EclipticGeoMoon(d).lon;
  function ascendant(date: Date, lat: number, lon: number) {
    const eps = (A.e_tilt(A.MakeTime(date)).tobl * Math.PI) / 180;
    const ramc = (norm(A.SiderealTime(date) * 15 + lon) * Math.PI) / 180;
    const phi = (lat * Math.PI) / 180;
    return norm((Math.atan2(Math.cos(ramc), -(Math.sin(ramc) * Math.cos(eps) + Math.tan(phi) * Math.sin(eps))) * 180) / Math.PI);
  }
  function offsetMin(date: Date, tz: string) {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).formatToParts(date);
    const g = (t: string) => Number(parts.find((x) => x.type === t)!.value);
    return Math.round((Date.UTC(g('year'), g('month') - 1, g('day'), g('hour'), g('minute')) - date.getTime()) / 60000);
  }
  function zonedToUtc(dateISO: string, time: string, tz: string) {
    const [y, m, d] = dateISO.split('-').map(Number), [hh, mm] = time.split(':').map(Number);
    const guess = Date.UTC(y, m - 1, d, hh, mm);
    const first = guess - offsetMin(new Date(guess), tz) * 60000;
    return new Date(guess - offsetMin(new Date(first), tz) * 60000);
  }

  const AREA = ['self', 'values', 'words', 'roots', 'joy', 'days', 'bonds', 'change', 'meaning', 'work', 'people', 'rest'];
  const ord = (n: number) => n + (n === 1 ? 'st' : n === 2 ? 'nd' : n === 3 ? 'rd' : 'th');
  function drawWheel(h: number) {
    const svg = $('wheel'); const NS = 'http://www.w3.org/2000/svg'; svg.innerHTML = '';
    const defs = document.createElementNS(NS, 'defs');
    defs.innerHTML = '<filter id="wglow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>';
    svg.appendChild(defs);
    const C = 80, R1 = 62, R2 = 74;
    for (let i = 0; i < 12; i++) {
      // house 1 on the left (the ascendant side), counting counter-clockwise like a chart
      const a0 = Math.PI + i * Math.PI / 6 + .05, a1 = a0 + Math.PI / 6 - .1;
      const pt = (r: number, a: number) => `${C + r * Math.cos(a)} ${C - r * Math.sin(a)}`;
      const d = `M ${pt(R2, a0)} A ${R2} ${R2} 0 0 0 ${pt(R2, a1)} L ${pt(R1, a1)} A ${R1} ${R1} 0 0 1 ${pt(R1, a0)} Z`;
      const on = i + 1 === h;
      if (on) { const g = document.createElementNS(NS, 'path'); g.setAttribute('d', d); g.setAttribute('fill', 'rgb(179 166 242)'); g.setAttribute('filter', 'url(#wglow)'); svg.appendChild(g); }
      const el = document.createElementNS(NS, 'path'); el.setAttribute('d', d);
      el.setAttribute('fill', on ? 'rgb(255 255 255 / .95)' : 'rgb(255 255 255 / .08)');
      el.setAttribute('stroke', 'rgb(255 255 255 / .18)'); el.setAttribute('stroke-width', '.5');
      svg.appendChild(el);
    }
    const ring = document.createElementNS(NS, 'circle'); ring.setAttribute('cx', '80'); ring.setAttribute('cy', '80'); ring.setAttribute('r', '54');
    ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', 'rgb(255 255 255 / .1)'); svg.appendChild(ring);
  }

  // City search (Open-Meteo geocoding, no key): only the typed city name leaves the browser.
  type Place = { name: string; admin1?: string; country?: string; latitude: number; longitude: number; timezone: string };
  let place: Place | null = null, results: Place[] = [], active = -1, timer = 0, seq = 0;
  const input = $('bplace') as HTMLInputElement, list = $('sugg') as HTMLUListElement;
  const label = (x: Place) => [x.name, x.admin1, x.country].filter(Boolean).join(', ');
  const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; };
  function show() {
    list.innerHTML = '';
    results.forEach((x, i) => {
      const li = document.createElement('li'); li.id = `bplace-${i}`; li.setAttribute('role', 'option'); li.setAttribute('aria-selected', String(i === active));
      li.textContent = x.name; const sm = document.createElement('small'); sm.textContent = [x.admin1, x.country].filter(Boolean).join(', '); li.appendChild(sm);
      li.addEventListener('mousedown', (e) => { e.preventDefault(); choose(i); });
      list.appendChild(li);
    });
    list.hidden = !results.length; input.setAttribute('aria-expanded', String(!!results.length));
    if (active >= 0) input.setAttribute('aria-activedescendant', `bplace-${active}`); else input.removeAttribute('aria-activedescendant');
  }
  function choose(i: number) { place = results[i]; input.value = label(place); close(); $('err').hidden = true; }
  input.addEventListener('input', () => {
    place = null; $('err').hidden = true; clearTimeout(timer);
    const q = input.value.trim(); if (q.length < 2) { results = []; show(); return; }
    timer = window.setTimeout(async () => {
      const my = ++seq;
      try {
        const r = await fetch(`https://geocoding-api.open-meteo.com/v1/search?count=6&language=en&format=json&name=${encodeURIComponent(q)}`);
        const j = await r.json(); if (my !== seq) return;
        results = (j.results || []).filter((x: Place) => x.timezone); active = -1; show();
      } catch { if (my === seq) { results = []; show(); } }
    }, 250);
  });
  input.addEventListener('keydown', (e) => {
    if (list.hidden) return;
    if (e.key === 'ArrowDown') { active = Math.min(results.length - 1, active + 1); show(); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { active = Math.max(0, active - 1); show(); e.preventDefault(); }
    else if (e.key === 'Enter' && active >= 0) { choose(active); e.preventDefault(); }
    else if (e.key === 'Escape') close();
  });
  input.addEventListener('blur', () => setTimeout(close, 120));
  const notime = $('notime') as HTMLInputElement, btime = $('btime') as HTMLInputElement;
  notime.addEventListener('change', () => { btime.disabled = notime.checked; });

  function fail(msg: string) { const e = $('err'); e.textContent = msg; e.hidden = false; }
  ($('form') as HTMLFormElement).addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = ($('bdate') as HTMLInputElement).value, t = btime.value, known = !notime.checked && !!t;
    if (!d) return fail('Add your birth date.');
    if (!notime.checked && !t) return fail('Add your birth time, or tick "I don\'t know my birth time".');
    if (!place) return fail('Pick your birth place from the list, so we know exactly where it is.');
    $('err').hidden = true;
    const birth = zonedToUtc(d, known ? t : '12:00', place.timezone);
    const sunSign = signOf(A.SunPosition(birth).elon), natalMoon = signOf(moonLon(birth));
    const first = known ? signOf(ascendant(birth, place.latitude, place.longitude)) : sunSign;
    const now = signOf(moonLon(new Date()));
    const h = ((SIGNS.indexOf(now) - SIGNS.indexOf(first) + 12) % 12) + 1, area = AREA[h - 1];
    $('hnum').textContent = ord(h); $('fhouse').textContent = ord(h); $('fsign').textContent = cap(now); $('farea').textContent = cap(area);
    $('rising').textContent = known ? cap(first) : 'Needs your time'; $('sun').textContent = cap(sunSign); $('nmoon').textContent = cap(natalMoon);
    const lead = now === natalMoon ? `Tonight the moon returns to the sign it held when you were born, ${cap(now)}. ` : '';
    $('house').textContent = lead + R.houses[String(h)];
    $('how').textContent = known
      ? `Counted from your rising sign, ${cap(first)}, born in ${place.name}.`
      : `Without a birth time, your houses are counted from your Sun sign. Add your time for your own houses.`;
    $('pname').textContent = `${R.phases[p.kind].name}, for ${area}`;
    drawWheel(h);
    $('yours').hidden = false;
    $('yours').scrollIntoView({ behavior: 'smooth', block: 'start' });
    (window as any).posthog?.capture?.('compass_done', { moon_sign: now, house: h, timed: known });
  });
</script>
