---
// "Tonight" card: the live moon (sign + phase) and, once a sign is picked, where it lands in that sky.
// Rendered at build time, then refreshed in the browser from the same calendar.
import moon from '../data/moon.json';
import R from '../data/readings.json';
import { SIGNS, SIGN_GLYPH, signAt, phaseAt, cycleAt, cap } from '../lib/moon';
const now = Date.now();
const s = signAt(moon as any, now);
const p = phaseAt(moon as any, now);
const reading = (R.phases as any)[p.kind];
const cyc = cycleAt(moon as any, now);
---
<div class="tonight glass" data-tonight>
  <div class="wash" aria-hidden="true"></div>
  <div class="row">
    <span class="label"><span class="dot"></span>Tonight</span>
    <span class="label" data-t="until"></span>
  </div>
  <div class="tmoon"><canvas data-light="moon" data-size="340" data-phase={cyc.toFixed(3)} data-t="moon" aria-label="Tonight's moon, drawn in points of light"></canvas></div>
  <h2 class="ttitle"><span data-t="phase">{reading.name}</span> in <span data-t="sign">{cap(s.sign)}</span></h2>
  <p class="tline" data-t="line">{reading.reading}, with {(R.signs as any)[s.sign].tone}</p>
  <div class="pick">
    <p class="label">What's your sign?</p>
    <div class="chips">
      {SIGNS.map((g) => <button class="schip" type="button" data-sign={g} aria-pressed="false">{cap(g)}</button>)}
    </div>
    <div class="yours" data-t="yours" hidden>
      <p class="label">In your sky</p>
      <p class="ytext" data-t="house"></p>
      <p class="small muted">Counted from your Sun sign. In the app, your birth time places it in your own houses.</p>
      <a class="btn primary" href="#start" data-cta="tonight">Get tonight's full reading</a>
    </div>
  </div>
</div>
<script type="application/json" id="lune-readings" set:html={JSON.stringify({ phases: R.phases, signs: R.signs, houses: R.houses })} />

<style>
  .tonight { --c: 179 166 242; position: relative; overflow: hidden; padding: 24px; display: grid; gap: 16px; max-width: 440px; width: 100%; margin-inline: auto; }
  .wash { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(110% 60% at 50% 30%, rgb(var(--c) / .30), rgb(var(--c) / .10) 50%, transparent 85%); }
  .tonight > :not(.wash) { position: relative; min-width: 0; }
  .row { display: flex; justify-content: space-between; }
  .row .label { display: flex; align-items: center; gap: 8px; }
  .tmoon { width: min(340px, 100%); aspect-ratio: 1; margin: -24px auto -32px; }
  .tmoon canvas { width: 100%; height: 100%; display: block; }
  .ttitle { font: var(--text-title); letter-spacing: -0.035em; text-align: center; color: var(--foreground); }
  .tline { margin: 0; text-align: center; font: var(--text-body); color: var(--muted-foreground); }
  .pick { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 16px; }
  .pick .label { margin: 0; }
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
  .schip { min-height: 38px; padding: 0 8px; border-radius: var(--radius-button); background: var(--glass-fill); border: 1px solid var(--glass-edge); box-shadow: var(--glass-highlight);
    color: var(--foreground); font: var(--text-label); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .schip:hover { background: var(--glass-selected); }
  .schip[aria-pressed="true"] { background: var(--foreground); color: var(--background); border-color: var(--foreground); }
  .yours { display: grid; gap: 8px; }
  .yours[hidden] { display: none; }
  .yours p { margin: 0; }
  .ytext { font: var(--text-body); color: var(--foreground); }
  .yours .btn { margin-top: 8px; }
</style>

<script>
  import moon from '../data/moon.json';
  import { signAt, phaseAt, houseFrom, cycleAt, cap } from '../lib/moon';
  const R = JSON.parse(document.getElementById('lune-readings')!.textContent!);
  const root = document.querySelector('[data-tonight]') as HTMLElement;
  const $ = (k: string) => root.querySelector(`[data-t="${k}"]`) as HTMLElement;
  const s = signAt(moon as any);
  const p = phaseAt(moon as any);
  $('phase').textContent = R.phases[p.kind].name;
  $('sign').textContent = cap(s.sign);
  $('line').textContent = `${R.phases[p.kind].reading}, with ${R.signs[s.sign].tone}`;
  $('moon').dataset.phase = cycleAt(moon as any).toFixed(3);
  if (s.until) $('until').textContent = 'until ' + new Date(s.until).toLocaleDateString('en-US', { weekday: 'short', hour: 'numeric' });
  const ord = (n: number) => n + (n === 1 ? 'st' : n === 2 ? 'nd' : n === 3 ? 'rd' : 'th');
  function pick(sign: string) {
    root.querySelectorAll('.schip').forEach((c) => c.setAttribute('aria-pressed', String((c as HTMLElement).dataset.sign === sign)));
    const h = houseFrom(s.sign, sign);
    const lead = h === 1 ? `Tonight the moon is in your sign, ${cap(sign)}. ` : '';
    $('house').textContent = lead + R.houses[String(h)].replace(/^In your \d+\w\w house/, `In your ${ord(h)} house`);
    $('yours').hidden = false;
    try { localStorage.setItem('lune-sign', sign); } catch {}
    (window as any).posthog?.capture?.('sign_picked', { sign, moon_sign: s.sign, house: h });
  }
  root.querySelectorAll('.schip').forEach((c) => c.addEventListener('click', () => pick((c as HTMLElement).dataset.sign!)));
  try { const saved = localStorage.getItem('lune-sign'); if (saved) pick(saved); } catch {}
</script>
