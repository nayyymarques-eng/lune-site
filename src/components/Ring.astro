---
// A ring of fairy lights circling whatever sits inside it, like Saturn's ring: the back half passes behind, the front half in front.
// w/h = box size in px, rx/ry = ring radii as a share of the box, tilt in degrees, n = points.
const { w = 560, h = 360, rx = 0.47, ry = 0.16, tilt = -12, n = 520, color = '255 246 232', speed = 0.05 } = Astro.props;
---
<div class="ring" style={`--w:${w}px;--h:${h}px`} data-ring={JSON.stringify({ rx, ry, tilt, n, color, speed })}>
  <canvas class="rb" aria-hidden="true"></canvas>
  <div class="rc"><slot /></div>
  <canvas class="rf" aria-hidden="true"></canvas>
</div>
<style>
  .ring { position: relative; width: min(var(--w), 100%); aspect-ratio: calc(var(--w) / var(--h)); display: grid; place-items: center; margin-inline: auto; }
  .ring canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .rb { z-index: 0; }
  .rc { position: relative; z-index: 1; display: grid; place-items: center; }
  .rf { z-index: 2; }
</style>
<script>
  const sprites: Record<string, HTMLCanvasElement> = {};
  function sprite(c: string) {
    if (sprites[c]) return sprites[c];
    const s = 64, cv = document.createElement('canvas'); cv.width = cv.height = s;
    const x = cv.getContext('2d')!, g = x.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
    g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.14, `rgba(${c},.9)`); g.addColorStop(0.34, `rgba(${c},.18)`); g.addColorStop(1, `rgba(${c},0)`);
    x.fillStyle = g; x.fillRect(0, 0, s, s); return (sprites[c] = cv);
  }
  const hash = (i: number, k: number) => { const s = Math.sin(i * 127.1 + k * 311.7) * 43758.5453; return s - Math.floor(s); };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-ring]').forEach((el) => {
    const o = JSON.parse(el.dataset.ring!);
    const [back, front] = [el.querySelector<HTMLCanvasElement>('.rb')!, el.querySelector<HTMLCanvasElement>('.rf')!];
    const c = o.color.split(' ').join(','), spr = sprite(c);
    let W = 0, H = 0, dpr = 1, visible = true;
    const size = () => { const r = el.getBoundingClientRect(); dpr = Math.min(2, devicePixelRatio || 1); W = r.width * dpr; H = r.height * dpr; for (const cv of [back, front]) { cv.width = W; cv.height = H; } };
    size(); if ('ResizeObserver' in window) new ResizeObserver(size).observe(el); else addEventListener('resize', size);
    new IntersectionObserver((es) => (visible = es[0].isIntersecting)).observe(el);
    const pts = [...Array(o.n)].map((_, i) => ({ a: hash(i, 1) * Math.PI * 2, r: 1 + (hash(i, 2) - 0.5) * 0.09 + (hash(i, 3) < 0.25 ? (hash(i, 4) - 0.5) * 0.2 : 0),
      sz: 0.6 + 1.6 * Math.pow(hash(i, 5), 3), tw: 0.8 + 2.2 * hash(i, 6), ph: hash(i, 7) * 6.28, star: hash(i, 8) < 0.03 }));
    const tilt = (o.tilt * Math.PI) / 180, ct = Math.cos(tilt), st = Math.sin(tilt);
    function draw(t: number) {
      const bx = back.getContext('2d')!, fx = front.getContext('2d')!;
      bx.clearRect(0, 0, W, H); fx.clearRect(0, 0, W, H);
      bx.globalCompositeOperation = fx.globalCompositeOperation = 'lighter';
      const cx = W / 2, cy = H / 2, RX = W * o.rx, RY = W * o.ry; // both radii are shares of the width
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i], a = p.a + t * o.speed, ex = Math.cos(a) * RX * p.r, ey = Math.sin(a) * RY * p.r;
        const x = cx + ex * ct - ey * st, y = cy + ex * st + ey * ct;
        const depth = Math.sin(a), ctx = depth > 0 ? fx : bx;
        const tw = 0.55 + 0.45 * Math.sin(t * p.tw + p.ph);
        const s = (p.star ? 8 : p.sz * 3.8) * dpr * (0.85 + 0.3 * depth);
        ctx.globalAlpha = Math.min(1, (0.5 + 0.5 * (depth * 0.5 + 0.5)) * (0.4 + 0.6 * tw));
        ctx.drawImage(spr, x - s / 2, y - s / 2, s, s);
      }
    }
    if (reduce) { draw(4); return; }
    let last = 0;
    const loop = (ms: number) => { if (visible && ms - last > 32) { last = ms; draw(ms / 1000); } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  });
</script>
