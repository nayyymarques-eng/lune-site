---
// App Store + Google Play buttons. Before launch they open early access and say "Coming soon".
import { APP_STORE_URL, PLAY_STORE_URL, LIVE } from '../config';
const { size = 'md', where = 'page' } = Astro.props;
const ios = APP_STORE_URL || '/#waitlist', android = PLAY_STORE_URL || '/#waitlist';
const pre = LIVE ? 'Download on the' : 'Coming soon to';
const preA = LIVE ? 'Get it on' : 'Coming soon to';
---
<div class:list={['stores', size]}>
  <a class="store" href={ios} data-cta={`store-ios-${where}`} aria-label={LIVE ? 'Download on the App Store' : 'App Store, coming soon: get early access'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.66-.39 6.6 1.1 8.75.73 1.05 1.6 2.24 2.73 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.4 1.2-2.46-.03-.01-2.3-.88-2.3-3.5zM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.65-1.05 1.69-.92 2.68.97.08 1.96-.49 2.56-1.23z"/></svg>
    <span><small>{pre}</small>App Store</span>
  </a>
  <a class="store" href={android} data-cta={`store-android-${where}`} aria-label={LIVE ? 'Get it on Google Play' : 'Google Play, coming soon: get early access'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.2 2.6c-.2.2-.3.6-.3 1v16.8c0 .4.1.8.3 1l9.3-9.4-9.3-9.4zm10.4 8.3 2.6-2.6L6 1.9c-.4-.2-.8-.3-1.1-.2l9.7 9.2zm0 2.2-9.7 9.2c.3.1.7 0 1.1-.2l11.2-6.4-2.6-2.6zm5.9-2.4-2.4-1.4-2.8 2.7 2.8 2.7 2.4-1.4c.7-.4.7-2.2 0-2.6z"/></svg>
    <span><small>{preA}</small>Google Play</span>
  </a>
</div>
<style>
  .stores { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .store { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 16px 0 12px; border-radius: var(--radius-button);
    background: var(--glass-fill); border: 1px solid var(--glass-edge); box-shadow: var(--glass-highlight); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    color: var(--foreground); text-decoration: none; transition: background .2s; }
  .store:hover { background: var(--glass-selected); }
  .store svg { width: 20px; height: 20px; flex: none; }
  .store span { display: grid; font: 500 15px/1.1 var(--font-sans); letter-spacing: -0.01em; text-align: left; }
  .store small { font: var(--text-label); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 2px; }
  .sm .store { min-height: 40px; padding: 0 12px 0 10px; }
  .sm .store span { font-size: 13px; }
  .sm .store small { font-size: 8px; margin-bottom: 1px; }
  @media (max-width: 720px) { .sm .store span { display: none; } .sm .store { padding: 0 10px; } }
</style>
