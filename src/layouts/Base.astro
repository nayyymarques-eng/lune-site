---
import '../styles/site.css';
import Wordmark from '../components/Wordmark.astro';
import Stores from '../components/Stores.astro';
import { CTA, POSTHOG_KEY, LIVE, APP_STORE_URL } from '../config';
const { glow = true, title, description = 'A 15-minute ritual for every moon, with what you already have at home.', image = '/brand/og.jpg', type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const full = title ? `${title} · Lune` : 'Lune: Moon Rituals · A small ritual for every moon';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/brand/app-icon-1024.webp" />
  <link rel="alternate" type="application/rss+xml" title="Lune Journal" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono&family=Tinos:wght@400&display=swap" rel="stylesheet" />
  {LIVE && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_URL.match(/id(\d+)/)?.[1] ?? ''}`} />}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {POSTHOG_KEY && <script is:inline define:vars={{ POSTHOG_KEY }}>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init(POSTHOG_KEY,{api_host:'https://us.i.posthog.com',person_profiles:'identified_only'});
  </script>}
</head>
<body>
  <div class="stars" aria-hidden="true"></div>
  <header class="top">
    <div class="wrap bar">
      <a href="/" aria-label="Lune home"><Wordmark /></a>
      <nav>
        <a href="/#how">How it works</a>
        <a href="/moon">Moon in your sign</a>
        <a href="/journal">Journal</a>
        <a href="/#pricing">Pricing</a>
      </nav>
      <Stores size="sm" where="header" />
    </div>
  </header>
  <main>{glow && <div class="bg l1 pglow" aria-hidden="true"></div>}<slot /></main>
  <footer class="foot">
    <div class="wrap fgrid">
      <div>
        <Wordmark height={28} />
        <p class="muted small" style="max-width:300px;margin-top:16px">A small ritual for every moon, fifteen minutes with what you have at home. The moon is a cue, never a prediction.</p>
      </div>
      <div class="fcol"><span class="label">Lune</span><a href="/#how">How it works</a><a href="/#pricing">Pricing</a><a href="/#faq">Questions</a></div>
      <div class="fcol"><span class="label">Read</span><a href="/moon">The moon in each sign</a><a href="/journal">Journal</a><a href="/rss.xml">RSS</a></div>
      <div class="fcol"><span class="label">Care</span><a href="/care">Before you begin</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/support">Support</a><a href="/delete-account">Delete account</a></div>
    </div>
    <div class="wrap small muted copy">© {new Date().getFullYear()} Lune. Not medical, psychological or financial advice. In crisis in the US, call or text 988.</div>
  </footer>
  <script is:inline src="/lights.js"></script>
  <script is:inline src="/lune-light.js"></script>
  <script is:inline src="/site-lights.js"></script>
  <script is:inline>
  (() => {
    const links = [...document.querySelectorAll('header nav a')], path = location.pathname.replace(/index\.html$/, '');
    const set = (a) => links.forEach((l) => l.classList.toggle('on', l === a));
    const byPath = links.find((l) => !l.hash && l.pathname !== '/' && path.startsWith(l.pathname));
    if (byPath) { set(byPath); return; }
    if (path !== '/' || !('IntersectionObserver' in window)) return;
    const secs = links.filter((l) => l.hash).map((l) => [l, document.querySelector(l.hash)]).filter(([, el]) => el);
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(secs.find(([, el]) => el === e.target)[0]); }), { rootMargin: '-45% 0px -50% 0px' });
    secs.forEach(([, el]) => io.observe(el));
    addEventListener('scroll', () => { if (scrollY < 200) set(null); }, { passive: true });
  })();
  </script>
  <a class="btn primary sticky-cta" href="/#start" data-cta="sticky">{CTA}</a>
  <script is:inline>
    (() => { const b = document.querySelector('.sticky-cta'), f = document.querySelectorAll('form, .hcol, .stores:not(.sm)'); if (!b || !('IntersectionObserver' in window) || !f.length) return;
      const seen = new Set(); const io = new IntersectionObserver(es => { es.forEach(e => e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)); b.classList.toggle('hide', seen.size > 0); });
      f.forEach(x => io.observe(x)); })();
  </script>
</body>
</html>
<style>
  .top { position: sticky; top: 0; z-index: 10; background: rgba(0,0,0,.6); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 24px; }
  nav { display: flex; gap: 24px; }
  nav a { font: var(--text-label); text-transform: uppercase; letter-spacing: .08em; color: var(--muted-foreground); text-decoration: none; }
  nav a { position: relative; padding: 8px 0; }
  nav a:hover, nav a.on { color: #fff; }
  nav a::after { content: ''; position: absolute; left: 50%; bottom: -2px; width: 4px; height: 4px; border-radius: 50%; background: #fff;
    box-shadow: 0 0 8px rgb(179 166 242 / .9); transform: translateX(-50%) scale(0); transition: transform .3s cubic-bezier(.22,1,.36,1); }
  nav a.on::after { transform: translateX(-50%) scale(1); }
  .foot { border-top: 1px solid var(--line); padding: 64px 0 32px; margin-top: 40px; }
  .fgrid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .fcol { display: grid; gap: 8px; align-content: start; }
  .fcol a { color: var(--muted-foreground); text-decoration: none; font: var(--text-body); }
  .fcol a:hover { color: #fff; }
  .copy { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); font: var(--text-small); }
  main { position: relative; }
  .pglow { height: 700px; -webkit-mask-image: none; mask-image: none; }
  .sticky-cta { display: none; }
  @media (max-width: 820px) {
    nav { display: none; }
    .fgrid { grid-template-columns: 1fr 1fr; }
    .fgrid > div:first-child { grid-column: 1 / -1; }
    .sticky-cta { display: flex; position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 20; box-shadow: 0 8px 30px #000; transition: opacity .3s, transform .3s; }
    .sticky-cta.hide { opacity: 0; transform: translateY(16px); pointer-events: none; }
    .foot { padding-bottom: 96px; }
  }
</style>
<script>
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-cta]') as HTMLElement | null;
    if (a) (window as any).posthog?.capture?.('cta_clicked', { where: a.dataset.cta });
  });
</script>
