---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('legal')).map((p) => ({ params: { legal: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title}>
  <article class="narrow" style="padding-block:64px">
    <h1 class="h-sec" style="margin-bottom:32px">{p.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
</Base>
