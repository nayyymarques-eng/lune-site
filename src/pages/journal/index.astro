---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('journal', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Journal" description="Notes on the moon, the signs and small practices to live them.">
  <section class="wrap">
    <div class="sec-head"><p class="label">Journal</p><h1 class="h-sec">Notes for each moon</h1></div>
    <div class="list">
      {posts.map((p) => (
        <a class="post glass" href={`/journal/${p.id}`}>
          <span class="label">{p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>
          <h2 class="h-card">{p.data.title}</h2>
          <p class="muted">{p.data.description}</p>
        </a>
      ))}
    </div>
    <div class="sub glass"><h2 class="h-card">One letter per moon</h2><Signup source="journal" note="The next moon, read for each sign. Unsubscribe any time." /></div>
  </section>
</Base>
<style>
  .list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .post { padding: 24px; display: grid; gap: 8px; text-decoration: none; align-content: start; }
  .post:hover { background: var(--glass-selected); }
  .post p { margin: 0; }
  .sub { margin-top: 48px; padding: 24px; display: grid; gap: 16px; }
  @media (max-width: 820px) { .list { grid-template-columns: 1fr; } }
</style>
