---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import { getCollection, render } from 'astro:content';
import { cap } from '../../lib/moon';
export async function getStaticPaths() {
  return (await getCollection('journal', (p) => !p.data.draft)).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: p.data.title, description: p.data.description, datePublished: p.data.date.toISOString(), publisher: { '@type': 'Organization', name: 'Lune' } };
---
<Base title={p.data.title} description={p.data.description} type="article" image={p.data.cover} schema={schema}>
  <article class="narrow art">
    <p class="label"><a href="/journal">Journal</a> · {p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>
    <h1 class="h-sec">{p.data.title}</h1>
    <p class="lead">{p.data.description}</p>
    {p.data.cover && <img src={p.data.cover} alt="" class="cover" />}
    <div class="prose"><Content /></div>
    <div class="cta glass">
      <h2 class="h-card">{p.data.sign ? `Is ${cap(p.data.sign)} your sign? Get the moon read for your sky` : 'Get the moon read for your own sky'}</h2>
      <Signup source={`post-${p.id}`} />
    </div>
  </article>
</Base>
<style>
  .art { padding-block: 64px; display: grid; gap: 20px; }
  .art .label a { text-decoration: none; }
  .lead { margin: 0; }
  .cover { border-radius: var(--radius-card); }
  .cta { padding: 24px; display: grid; gap: 16px; margin-top: 40px; }
</style>
