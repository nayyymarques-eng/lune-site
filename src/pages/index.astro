---
import Base from '../layouts/Base.astro';
import Ring from '../components/Ring.astro';
import Wordmark from '../components/Wordmark.astro';
import Signup from '../components/Signup.astro';
import moon from '../data/moon.json';
import R from '../data/readings.json';
import PhaseIcon from '../components/PhaseIcon.astro';
import { cap, fmtDate, utcOf, cycleAt } from '../lib/moon';
import { PRICE, CTA } from '../config';

const now = Date.now();
const big = (moon as any).phases.filter((p: any) => (p.kind === 'new_moon' || p.kind === 'full_moon') && utcOf(p.utc) > now).slice(0, 4).map((p: any) => {
  const ecl = (moon as any).eclipses.find((e: any) => Math.abs(utcOf(e.utc) - utcOf(p.utc)) < 864e5);
  const tag = ecl ? (ecl.kind === 'solar_eclipse' ? 'Solar eclipse' : 'Lunar eclipse') : p.kind === 'full_moon' && p.perigee_pct >= 90 ? 'Supermoon' : '';
  const s = (R.signs as any)[p.sign];
  return { ...p, tag, name: `${p.kind === 'new_moon' ? 'New' : 'Full'} moon in ${cap(p.sign)}`, text: p.kind === 'new_moon' ? s.new : s.full };
});

const faq = [
  ['Do I need to believe in astrology?', 'No. Lune reads the moon as a mirror, never as a prediction. The moon does nothing by itself: a phase is a moment, the sign a tone, the house an area of life. You bring the meaning.'],
  ['Is Lune religious?', 'Lune is spiritual, not religious. Practices come from many traditions, shown side by side as kin, never ranked. Believe what you choose.'],
  ['What do I need for a practice?', 'What you already have at home: a candle, a glass of water, paper and a pen. Tell Lune what you have and practices start from it. Fifteen minutes, often less.'],
  ['Do I need my birth time?', 'No. Without it, Lune counts your houses from your Sun sign. Add it whenever you like to see the moon in your own houses.'],
  ['Is the science real?', 'Every "What science says" cites a published study, with its limits said plainly. Where no study exists, we say so.'],
  ['How does the trial work?', `Premium is free for ${PRICE.trialDays} days. After that it is ${PRICE.month} a month or ${PRICE.year} a year, and you can cancel any time in your store settings. The free tier stays free.`],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'MobileApplication', name: 'Lune: Moon Rituals', operatingSystem: 'iOS, Android', applicationCategory: 'LifestyleApplication',
    offers: [{ '@type': 'Offer', price: '9.99', priceCurrency: 'USD' }, { '@type': 'Offer', price: '59.99', priceCurrency: 'USD' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base glow={false} description="Lune reads tonight's moon for your own sky, then offers a 15-minute practice with what you already have at home. Free to start." schema={schema}>
  <section class="hero">
    <div class="bg l1" aria-hidden="true"></div>
    <div class="wrap hcol" id="start"><span id="waitlist" aria-hidden="true"></span>
      <Ring w={640} h={340} rx={0.46} ry={0.13} tilt={-10} n={620}>
        <img class="hlogo" src="/brand/lune-white.svg" alt="Lune" width="300" height="135" />
      </Ring>
      <h1 class="h-hero">Your moon, read for you</h1>
      <p class="lead">Every night the moon crosses a sign and touches one part of your life. Lune reads it for your own sky, then offers a 15-minute practice to live it, with what you already have at home.</p>
      <div class="hform"><Signup source="hero" /></div>
      <ul class="proof">
        <li><span class="spark"></span>The moon, timed to the minute through 2030</li>
        <li><span class="spark"></span>Gestures kept by traditions across the world</li>
        <li><span class="spark"></span>Every word with its source</li>
      </ul>
    </div>
  </section>

  <section class="app">
    <div class="bg l2" style="--bgc: 179 166 242" aria-hidden="true"></div>
    <div class="wrap agrid">
      <Ring w={620} h={760} rx={0.47} ry={0.2} tilt={-16} n={560} speed={0.035}>
        <div class="phone"><img src="/brand/app-h1-today.webp" alt="The Lune app: tonight's full moon in Taurus, read for your sky" width="430" height="932" loading="lazy" /></div>
      </Ring>
      <div class="acopy">
        <p class="label">Tonight, in the app</p>
        <h2 class="h-sec">One sentence for your night, then the why</h2>
        <p class="lead">Each evening Lune opens on the moon above you: what the night is good for, what to go easy on, and where it falls in your own chart. Two months of moons sit one swipe away.</p>
        <a class="btn secondary" href="/tonight" data-cta="app-tonight">Read tonight's moon for your sign</a>
      </div>
    </div>
  </section>

  <section id="how" class="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">How it works</p>
        <h2 class="h-sec">Three steps, one night at a time</h2>
      </div>
      <ol class="steps">
        <li class="tint" style="--c: 179 166 242">
          <canvas class="slight" data-light="breath" data-size="96" data-color="179 166 242" aria-hidden="true"></canvas>
          <span class="label">01 · The moon</span>
          <h3 class="h-card">Tonight's phase and sign, in plain, warm words</h3>
          <p class="muted">What the night is good for, and what to go easy on. No jargon without a reason.</p>
        </li>
        <li class="tint" style="--c: 143 184 242">
          <canvas class="slight" data-light="ripple" data-size="96" data-color="143 184 242" aria-hidden="true"></canvas>
          <span class="label">02 · Where it lands in your sky</span>
          <h3 class="h-card">Your Sun, your rising sign, your houses</h3>
          <p class="muted">The same moon falls on a different part of every life. Lune shows you where it falls on yours.</p>
        </li>
        <li class="tint" style="--c: 240 169 124">
          <canvas class="slight" data-light="flame" data-size="96" data-color="240 169 124" aria-hidden="true"></canvas>
          <span class="label">03 · A practice to live it</span>
          <h3 class="h-card">Fifteen minutes, with a candle and a pen</h3>
          <p class="muted">Open, a few gestures, close. Choose love, work, health, prosperity, energy, gratitude, new paths or the divine.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="pillars">
    <div class="bg l2" style="--bgc: 232 140 221" aria-hidden="true"></div>
    <div class="wrap pgrid">
      <div class="plight"><canvas data-light="galaxy" data-size="430" data-r="0.62" data-color="232 140 221" aria-hidden="true"></canvas></div>
      <div class="pcopy">
        <p class="label">Every practice, three ways to see it</p>
        <h2 class="h-sec">Yours, where it comes from, and what science says</h2>
        <dl class="three">
          <div><dt class="label">Yours</dt><dd>Why tonight, for you: the sign and house where the moon falls in your chart.</dd></div>
          <div><dt class="label">Where it comes from</dt><dd>The tradition behind the gesture, and the same gesture in another tradition, as kin.</dd></div>
          <div><dt class="label">What science says</dt><dd>What studies suggest, cited, with their limits said gently.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="cal">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Coming up</p>
        <h2 class="h-sec">The next moons, planned two months ahead</h2>
      </div>
      <div class="cgrid">
        {big.map((m: any, i: number) => (
          <a class="mcard tint" style={`--c: ${['179 166 242', '232 201 140', '143 184 242', '242 184 176'][i % 4]}`} href={`/moon/${m.sign}`}>
            <div class="row"><span class="label">{fmtDate(utcOf(m.utc))}</span>{m.tag && <span class="badge">{m.tag}</span>}</div>
            <PhaseIcon phase={m.kind} size={32} />
            <h3 class="h-card">{m.name}</h3>
            <p class="muted">{m.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="why">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Why Lune</p>
        <h2 class="h-sec">An old rhythm for a tired, lit-up life</h2>
        <p class="lead">Our days run on screens and notifications. Lune uses the oldest clock we have, the moon, as a gentle cue to put the phone down, light a candle and come back to yourself. Ritual as routine: small, regular, yours.</p>
      </div>
      <div class="wgrid">
        <div class="glass wcell"><canvas data-light="halo" data-size="64" data-color="179 166 242" aria-hidden="true"></canvas><h3 class="h-card">A mirror, never a prophecy</h3><p class="muted">Astrology here is a way to reflect. The moon decides nothing; you bring the meaning.</p></div>
        <div class="glass wcell"><canvas data-light="three" data-size="64" data-color="143 184 242" aria-hidden="true"></canvas><h3 class="h-card">Many traditions, as kin</h3><p class="muted">Each gesture shows where it comes from, beside the same gesture in another culture. Spiritual, not religious.</p></div>
        <div class="glass wcell"><canvas data-light="clear" data-size="64" data-color="158 220 164" aria-hidden="true"></canvas><h3 class="h-card">Science, said gently</h3><p class="muted">What studies suggest, cited, with their limits. Where no study exists, we say so.</p></div>
        <div class="glass wcell"><canvas data-light="flame" data-size="64" data-color="240 169 124" aria-hidden="true"></canvas><h3 class="h-card">Care before anything</h3><p class="muted">A practice is a moment of attention, not treatment. Nothing is ever aimed at another person's will.</p></div>
      </div>
    </div>
  </section>

  <section id="pricing" class="pricing">
    <div class="bg l1" aria-hidden="true"></div>
    <div class="wrap">
      <div class="sec-head center">
        <p class="label">Pricing</p>
        <h2 class="h-sec">Free to start, Premium for every moon</h2>
      </div>
      <div class="prgrid">
        <div class="plan glass">
          <p class="label">Free</p>
          <p class="price">$0</p>
          <p class="muted">Always free, no card.</p>
          <ul class="feats">
            <li>Tonight's moon, read for your sky</li>
            <li>This month's moons</li>
            <li>A few practices to try</li>
          </ul>
          <a class="btn secondary" href="#start" data-cta="pricing-free">{CTA}</a>
        </div>
        <div class="plan glass sel" data-plan>
          <div class="row"><p class="label">Premium</p>
            <div class="seg" role="tablist" aria-label="Billing">
              <button type="button" role="tab" data-p="month" aria-selected="false">Monthly</button>
              <button type="button" role="tab" data-p="year" class="on" aria-selected="true">Yearly</button>
            </div>
          </div>
          <p class="price"><span data-v="year">{PRICE.year}</span><span data-v="month" hidden>{PRICE.month}</span><span class="per"><span data-v="year"> / year</span><span data-v="month" hidden> / month</span></span></p>
          <p class="muted"><span data-v="year">{PRICE.yearPerMonth} a month, half the monthly price. </span>{PRICE.trialDays} days free, cancel any time.</p>
          <ul class="feats">
            <li>Every practice, every night</li>
            <li>The full calendar, eclipses and supermoons</li>
            <li>Your altar: 163 items with history and science</li>
          </ul>
          <a class="btn primary" href="#start" data-cta="pricing-premium">{CTA}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="narrow">
      <div class="sec-head"><p class="label">Questions</p><h2 class="h-sec">Before you begin</h2></div>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}<svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="final">
    <div class="bg l3" style="--bgc: 179 166 242" aria-hidden="true"></div>
    <div class="narrow center">
      <canvas class="fmoon" data-light="moon" data-size="140" data-phase="0.5" aria-hidden="true"></canvas>
      <h2 class="h-sec">The next moon is already on its way</h2>
      <p class="lead">Be there when it arrives.</p>
      <div class="fform"><Signup source="final" /></div>
    </div>
  </section>
</Base>

<style>
  section { position: relative; }
  .hero { padding-top: 48px; overflow: hidden; }
  .hcol { display: grid; justify-items: center; text-align: center; gap: 24px; }
  .hlogo { width: 300px; height: auto; }
  .hcol .h-hero { margin-top: -16px; }
  .hcol .lead { max-width: 600px; }
  .hform { display: grid; justify-items: center; width: 100%; }
  .hform :global(form) { justify-content: center; margin-inline: auto; }
  .proof { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; font: var(--text-body); color: var(--muted-foreground); }
  .proof li { display: flex; align-items: center; gap: 8px; }
  .spark { width: 4px; height: 4px; border-radius: 50%; background: #fff; flex: none;
    box-shadow: 0 0 4px 1px rgba(255,246,232,.9), 0 0 12px 3px rgba(232,201,140,.35); animation: spark 3.2s ease-in-out infinite; }
  .proof li:nth-child(2) .spark { animation-delay: -1.1s; }
  .proof li:nth-child(3) .spark { animation-delay: -2.2s; }
  @keyframes spark { 0%, 100% { opacity: .55; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.15); } }
  .app { overflow: hidden; }
  .agrid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .agrid > * { min-width: 0; }
  .phone { width: 300px; aspect-ratio: 430 / 932; border-radius: 44px; padding: 8px; background: #0b0b0b; border: 1px solid var(--glass-edge);
    box-shadow: var(--glass-highlight), 0 40px 120px rgba(0,0,0,.8); }
  .phone img { width: 100%; height: 100%; object-fit: cover; border-radius: 36px; }
  .acopy { display: grid; gap: 24px; justify-items: start; }
  .why .lead { max-width: 640px; }
  .wgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .wcell { padding: 24px; display: grid; gap: 16px; align-content: start; }
  .wcell p { margin: 0; }
  .wcell canvas { width: 64px; height: 64px; margin: -8px 0 0 -8px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { padding: 24px; display: grid; gap: 16px; align-content: start; }
  .steps p { margin: 0; }
  .slight { width: 96px; height: 96px; margin: -8px 0 0 -8px; }
  .tint { border-radius: var(--radius-card); border: 1px solid rgb(var(--c) / .18); background: radial-gradient(130% 90% at 50% 0%, rgb(var(--c) / .12), transparent 62%), var(--glass-fill);
    box-shadow: var(--glass-highlight); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); }
  .pillars { overflow: hidden; }
  .pgrid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .plight { display: grid; place-items: center; }
  .plight canvas { width: 430px; height: 430px; max-width: 100%; }
  .pcopy { display: grid; gap: 24px; }
  .three { display: grid; gap: 16px; margin: 0; }
  .three div { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 8px; }
  .three dd { margin: 0; font: var(--text-body); color: var(--foreground); }
  .cgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .mcard { padding: 24px; display: grid; gap: 16px; text-decoration: none; align-content: start; }
  .mcard p { margin: 0; font: var(--text-body); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .badge { font: var(--text-label); text-transform: uppercase; letter-spacing: .08em; padding: 4px 8px; border-radius: 999px; border: 1px solid var(--glass-edge); background: var(--glass-fill); color: var(--foreground); }
  .center { text-align: center; margin-inline: auto; justify-items: center; }
  .prgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 840px; margin: 0 auto; }
  .plan { padding: 24px; display: grid; gap: 16px; align-content: start; }
  .plan p { margin: 0; }
  .plan.sel { background: var(--glass-selected); border-color: rgba(255,255,255,.24); }
  .plan .btn { margin-top: 8px; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; padding: var(--space-xs); border-radius: var(--radius-button); background: var(--glass-fill); border: 1px solid var(--glass-edge); }
  .seg button { min-height: 32px; padding: 0 16px; border: 0; border-radius: 8px; background: none; color: var(--muted-foreground); font: var(--text-label); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .seg button.on { background: var(--glass-selected); color: var(--foreground); }
  .price { font-family: var(--font-serif); font-size: 40px; letter-spacing: -0.035em; line-height: 1.04; color: var(--foreground); }
  .per { font: var(--text-body); letter-spacing: 0; color: var(--muted-foreground); }
  .feats { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .feats li { padding-left: 16px; position: relative; color: var(--foreground); }
  .feats li::before { content: ''; position: absolute; left: 0; top: 10px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; font: var(--text-body); font-size: 18px; color: var(--foreground); }
  summary::-webkit-details-marker { display: none; }
  .chev { flex: none; color: var(--muted-foreground); transition: transform .3s; }
  details[open] .chev { transform: rotate(180deg); }
  details p { margin: 8px 0 0; }
  .final { overflow: hidden; }
  .final .narrow { position: relative; display: grid; gap: 24px; }
  .fmoon { width: 140px; height: 140px; margin: 0 auto; }
  .fform { display: grid; justify-items: center; }
  @media (max-width: 900px) {
    .pgrid, .agrid { grid-template-columns: 1fr; }
    .wgrid { grid-template-columns: 1fr 1fr; }
    .phone { width: 240px; }
    .hlogo { width: 200px; }
    .steps, .prgrid { grid-template-columns: 1fr; }
    .cgrid { grid-template-columns: 1fr 1fr; }
    .plan.sel { order: -1; }
  }
  @media (max-width: 560px) { .cgrid, .wgrid { grid-template-columns: 1fr; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-plan]').forEach((card) => {
    card.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) => b.addEventListener('click', () => {
      const p = b.dataset.p!;
      card.querySelectorAll('.seg button').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
      card.querySelectorAll<HTMLElement>('[data-v]').forEach((el) => (el.hidden = el.dataset.v !== p));
    }));
  });
</script>
