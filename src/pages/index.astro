---
import Base from '../layouts/Base.astro';
import Ring from '../components/Ring.astro';
import Sky from '../components/Sky.astro';
import Stores from '../components/Stores.astro';
import Wordmark from '../components/Wordmark.astro';
import Signup from '../components/Signup.astro';
import moon from '../data/moon.json';
import R from '../data/readings.json';
import PhaseIcon from '../components/PhaseIcon.astro';
import { cap, fmtDate, utcOf, cycleAt } from '../lib/moon';
import { CTA } from '../config';

const now = Date.now();
const big = (moon as any).phases.filter((p: any) => (p.kind === 'new_moon' || p.kind === 'full_moon') && utcOf(p.utc) > now).slice(0, 4).map((p: any) => {
  const ecl = (moon as any).eclipses.find((e: any) => Math.abs(utcOf(e.utc) - utcOf(p.utc)) < 864e5);
  const tag = ecl ? (ecl.kind === 'solar_eclipse' ? 'Solar eclipse' : 'Lunar eclipse') : p.kind === 'full_moon' && p.perigee_pct >= 90 ? 'Supermoon' : '';
  const s = (R.signs as any)[p.sign];
  return { ...p, tag, name: `${p.kind === 'new_moon' ? 'New' : 'Full'} moon in ${cap(p.sign)}`, text: p.kind === 'new_moon' ? s.new : s.full };
});

const faq = [
  ['Do I need to believe in astrology?', 'No. Lune holds belief at many depths. Some people feel the moon as something sacred, some use it as the oldest clock we have, some come for the pause it asks of them. The practice is the same for all of them: a phase is a moment, a sign a tone, a house an area of life. The moon decides nothing. You bring the meaning.'],
  ['Is Lune religious?', 'Lune is spiritual, not religious. Each gesture shows the people who kept it and its kin in other cultures, side by side, never ranked. Take what speaks to you and believe what you choose.'],
  ['What do I need for a practice?', 'What you already have at home: a candle, a glass of water, paper and a pen. Tell Lune what you have and practices start from it. Each one walks you through the gestures, step by step, and tells you why they matter. Take as long as the moment asks.'],
  ['Do I need my birth time?', 'No. Without it, Lune counts your houses from your Sun sign. Add it whenever you like to see the moon in your own houses.'],
  ['Is the science real?', 'Every "What science says" cites published research, mostly neuroscience and psychology on breath, ritual and attention: who was studied, for how long, and where the evidence is still thin. Where no study exists, we say so, and let the tradition speak for itself.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'MobileApplication', name: 'Lune: Moon Rituals', operatingSystem: 'iOS, Android', applicationCategory: 'LifestyleApplication' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base glow={false} description="A guide for the spirituality you are growing into: a ritual for every moon, how to do it, where it comes from and why it matters. Be the first to download Lune." schema={schema}>
  <section class="hero">
    <Sky />
    <div class="hleft">
      <div class="hmoonw">
        <canvas class="hmoon" data-light="moon" data-size="380" data-phase={cycleAt(moon as any).toFixed(3)} aria-hidden="true"></canvas>
        <script is:inline>document.currentScript.previousElementSibling.dataset.phase = (((Date.now() - 947182440000) / 2551442877) % 1).toFixed(3);</script>
        <div class="hmark"><Wordmark height={72} /></div>
      </div>
    </div>
    <div class="glass hcard hcol" id="start" data-solid><span id="waitlist" aria-hidden="true"></span>
      <h1 class="h-hero">{"A ritual for every moon".split(" ").map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{" "}</>)}</h1>
      <p class="lead">For the spirituality you are growing into. Each moon, Lune gives your wishes, prayers and meditations a ritual: how to do it, where the gesture was born, and why it can matter, honouring every tradition that kept it.</p>
      <div class="hform"><Signup source="hero" /></div>
      <Stores where="hero" />
      <a class="more" href="/tonight" data-cta="hero-tonight">Or see tonight's moon first <span aria-hidden="true">→</span></a>
      <ul class="proof">
        <li><span class="spark"></span>A ritual for every moon through 2030</li>
        <li><span class="spark"></span>Gestures honoured with their roots and their kin</li>
        <li><span class="spark"></span>What science says, with its sources</li>
      </ul>
    </div>
  </section>

  <section class="why">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Why Lune</p>
        <h2 class="h-sec">A different way to connect with something bigger</h2>
        <p class="lead">Every act in Lune is read from three sides at once. The moon gives it a time. A tradition, somewhere in the world, gives it a memory. Neuroscience and psychology are beginning to show what it does in us. You decide how much to believe: a prayer, a symbol, or simply a pause. Each level is welcome, and each one adds meaning to the same small gesture.</p>
      </div>
      <div class="wgrid">
        <div class="glass wcell"><canvas data-light="vortex" data-size="96" data-sparkle data-live data-color="179 166 242" aria-hidden="true"></canvas><h3 class="h-card">The moon keeps the time</h3><p class="muted">Each phase is a moment to begin, to tend or to let go. It decides nothing; it only asks you to pause and choose.</p></div>
        <div class="glass wcell"><canvas data-light="flame" data-size="96" data-sparkle data-live data-color="143 184 242" aria-hidden="true"></canvas><h3 class="h-card">Gestures with a long memory</h3><p class="muted">A candle, a glass of water, a knot in a cord. Each one shows the people who kept it, beside its kin in another culture. Spiritual, not religious.</p></div>
        <div class="glass wcell"><canvas data-light="salt" data-size="96" data-sparkle data-live data-color="158 220 164" aria-hidden="true"></canvas><h3 class="h-card">What the mind tells us</h3><p class="muted">What neuroscience and psychology have found about breath, ritual and attention, cited with their limits. Where no study exists, we say so.</p></div>
        <div class="glass wcell"><canvas data-light="steam" data-size="96" data-sparkle data-live data-color="240 169 124" aria-hidden="true"></canvas><h3 class="h-card">Meaning at your own depth</h3><p class="muted">Believe all of it, some of it or none. A practice is a moment of attention, never treatment, and never aimed at another person's will.</p></div>
      </div>
    </div>
  </section>

  <section class="app">
    <div class="bg l2" style="--bgc: 179 166 242" aria-hidden="true"></div>
    <div class="wrap agrid">
      <Ring w={620} h={760} rx={0.47} ry={0.2} tilt={-16} n={560} speed={0.035}>
        <div class="phones">
          <div class="phone back"><img src="/brand/app-h1-today.webp" alt="The Lune app: tonight's moon, read for you" width="430" height="932" loading="lazy" /></div>
          <div class="phone front"><img src="/brand/app-p1-practice.webp" alt="A Lune practice: fifteen minutes, open, a few gestures, close" width="430" height="932" loading="lazy" /></div>
        </div>
      </Ring>
      <div class="acopy">
        <p class="label">Tonight, in the app</p>
        <h2 class="h-sec">Tonight's practice, waiting for you</h2>
        <p class="lead">Each evening Lune opens on the moon above you and a practice made for it. You arrive, you set your intention, you make the gestures with care, you close. Beside every step: why tonight, where the gesture was born and what the studies say, so you know what you are honouring and what it can do in you.</p>
        <a class="btn secondary" href="/tonight" data-cta="app-tonight">See tonight's moon</a>
      </div>
    </div>
  </section>

  <section id="how" class="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">How it works</p>
        <h2 class="h-sec">Light it, live it, let it go</h2>
      </div>
      <ol class="steps" aria-label="Three steps, swipe to see more">
        <li class="tint" style="--c: 179 166 242">
          <canvas class="slight" data-light="moon" data-size="220" data-r="0.4" data-phase="0.5" data-sparkle aria-hidden="true"></canvas>
          <span class="label">01 · Tonight's moon</span>
          <h3 class="h-card">What the night is asking</h3>
          <p class="muted">A few words on the moon's mood: what tonight invites, and what to hold more lightly. Written as a mirror, never as a forecast.</p>
        </li>
        <li class="tint" style="--c: 240 169 124">
          <canvas class="slight" data-light="burst" data-size="220" data-r="0.42" data-sparkle data-color="240 169 124" aria-hidden="true"></canvas>
          <span class="label">02 · A practice to live it</span>
          <h3 class="h-card">A gesture, done with meaning</h3>
          <p class="muted">A candle, water, paper, your breath. Lune shows you how, step by step, around what matters to you now: love, work, health, prosperity, gratitude, new paths or the divine. Every way of doing it is welcome.</p>
        </li>
        <li class="tint" style="--c: 143 184 242">
          <canvas class="slight" data-light="jar" data-size="220" data-r="0.42" data-sparkle data-color="143 184 242" aria-hidden="true"></canvas>
          <span class="label">03 · Keep it</span>
          <h3 class="h-card">A quiet record of your moons</h3>
          <p class="muted">Each practice stays with you, so at the full moon you can look back at what you planted at the new one, and see what it became.</p>
        </li>
      </ol>
      <a class="more" href="#waitlist" data-cta="how-more">Get early access <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="sci" aria-labelledby="sci-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">What science says</p>
        <h2 class="h-sec" id="sci-title">Why rituals still matter</h2>
        <p class="lead">Every culture has kept rituals, and science is beginning to see why. A gesture repeated with intention steadies the breath, quiets the alarm of the mind, and gives a feeling somewhere to go. These are the studies behind Lune, with their limits.</p>
      </div>
      <ol class="stats" aria-label="Six findings, swipe to see more">
        <li class="glass stat"><p class="num">79%<span> of studies</span></p><p class="muted">In a large review of research on spirituality and mental health, most studies linked a living spiritual life with more well-being, and many with less depression and anxiety.<sup>1</sup></p><p class="lim">Associations, not proof.</p></li>
        <li class="glass stat"><p class="num">6<span> breaths a minute</span></p><p class="muted">Praying the rosary and reciting a yoga mantra both slowed breathing to the same calm rhythm, and heart and breath fell into step. Two traditions, one rhythm.<sup>2</sup></p><p class="lim">23 adults, measured during the practice.</p></li>
        <li class="glass stat"><p class="num">13,512<span> people</span></p><p class="muted">In 49 studies, faith lived as support, meaning and trust went with coping better under stress. Faith lived as fear went with more suffering. Lune only offers the gentle kind.<sup>3</sup></p><p class="lim">Meta-analysis.</p></li>
        <li class="glass stat"><p class="num">Calmer<span> before a hard task</span></p><p class="muted">A short ritual lowered anxiety and heart rate and improved performance, but only when people did the gestures as a ritual, not as random moves.<sup>4</sup></p><p class="lim">Laboratory tasks.</p></li>
        <li class="glass stat"><p class="num">Lighter<span> after a loss</span></p><p class="muted">People who made a ritual after losing someone or something grieved less, because it gave them back a sense of control, even those who said they did not believe in rituals.<sup>5</sup></p><p class="lim">Moderate effect.</p></li>
        <li class="glass stat"><p class="num">¼<span> the risk</span></p><p class="muted">Over ten years, adults who said spirituality mattered deeply to them had about a quarter of the risk of depression. Going to services made no difference; personal meaning did.<sup>6</sup></p><p class="lim">114 adults, one small study.</p></li>
      </ol>
      <ol class="refs">
        <li><a href="https://doi.org/10.1192/bja.2019.81" rel="noopener" target="_blank">Koenig, Al-Zaben &amp; VanderWeele (2020), BJPsych Advances</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/11751348/" rel="noopener" target="_blank">Bernardi et al. (2001), BMJ</a></li>
        <li><a href="https://doi.org/10.1002/jclp.20049" rel="noopener" target="_blank">Ano &amp; Vasconcelles (2005), Journal of Clinical Psychology</a></li>
        <li><a href="https://doi.org/10.1016/j.obhdp.2016.07.004" rel="noopener" target="_blank">Brooks et al. (2016), Organizational Behavior and Human Decision Processes</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/23398180/" rel="noopener" target="_blank">Norton &amp; Gino (2014), Journal of Experimental Psychology: General</a></li>
        <li><a href="https://psychophysiology.cpmc.columbia.edu/publications/miller2012a" rel="noopener" target="_blank">Miller et al. (2012), American Journal of Psychiatry</a></li>
      </ol>
      <p class="note">A practice is a moment of attention, never a treatment. Lune never promises results.</p>
    </div>
  </section>

  <section class="pillars">
    <div class="bg l2" style="--bgc: 232 140 221" aria-hidden="true"></div>
    <div class="wrap pgrid">
      <div class="plight"><canvas data-light="galaxy" data-size="430" data-r="0.46" data-sparkle data-color="232 140 221" aria-hidden="true"></canvas></div>
      <div class="pcopy">
        <p class="label">Every practice, three ways to see it</p>
        <h2 class="h-sec">One gesture, many layers of meaning</h2>
        <dl class="three">
          <div><dt class="label">Yours</dt><dd>Why tonight, for you: the sign and house where the moon falls in your sky, and the part of life it lights.</dd></div>
          <div><dt class="label">Where it comes from</dt><dd>The people who kept this gesture, and its kin in another culture. Many roots, none ranked above the others.</dd></div>
          <div><dt class="label">What science says</dt><dd>What neuroscience and psychology have found about breath, ritual and attention, with who was studied and where the evidence ends.</dd></div>
        </dl>
        <a class="more" href="/journal" data-cta="pillars-more">Read the journal <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="cal">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Coming up</p>
        <h2 class="h-sec">Plan two moons ahead</h2>
      </div>
      <div class="cgrid">
        {big.map((m: any, i: number) => (
          <a class="mcard tint" style={`--c: ${['179 166 242', '232 201 140', '143 184 242', '242 184 176'][i % 4]}`} href={`/moon/${m.sign}`}>
            <div class="row"><span class="label">{fmtDate(utcOf(m.utc))}</span>{m.tag && <span class="badge">{m.tag}</span>}</div>
            <PhaseIcon phase={m.kind} size={32} />
            <h3 class="h-card">{m.name}</h3>
            <p class="muted">{m.text}</p>
          </a>
        ))}
      </div>
      <a class="more" href="/moon" data-cta="cal-more">See the moon in every sign <span aria-hidden="true">→</span></a>
    </div>
  </section>


  <section id="faq" class="faq">
    <div class="narrow">
      <div class="sec-head"><p class="label">Questions</p><h2 class="h-sec">Before you begin</h2></div>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}<svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="final">
    <Sky fade="both" />
    <div class="narrow center">
      <canvas class="fmoon" data-light="moon" data-size="140" data-phase="0.5" aria-hidden="true"></canvas>
      <h2 class="h-sec">The next moon is already on its way</h2>
      <p class="lead">Something bigger keeps its rhythm, whether we watch or not. Be there when it arrives.</p>
      <div class="fform"><Signup source="final" /></div>
    </div>
  </section>
</Base>

<style>
  section { position: relative; }
  /* Hero (Nayara 26 Oct): desktop = moon and logo on the sky at left, full-height glass panel at right;
     mobile = moon with the logo inside it, the card rising over its lower half. */
  .hero { position: relative; min-height: min(100svh - 65px, 920px); display: grid; grid-template-columns: 1fr minmax(460px, 44%); align-items: stretch; padding: 0; overflow: hidden; }
  .hleft { position: relative; z-index: 1; display: grid; place-items: center; padding: 64px 24px; }
  .hmoonw { position: relative; display: grid; justify-items: center; gap: 24px; }
  .hmoon { width: 380px; height: 380px; display: block; }
  .hmark { display: grid; justify-items: center; }
  .hcard { position: relative; z-index: 2; box-sizing: border-box; min-width: 0; display: grid; gap: 20px; align-content: center; justify-items: start; padding: 72px clamp(32px, 5vw, 72px); border: 0; border-radius: 0; overflow: hidden;
    /* Tinted sheet that melts into the next section at the bottom; a hairline on its left edge fades the same way. */
    background: linear-gradient(to bottom, rgb(22 22 28 / .9), rgb(16 16 20 / .9) 72%, rgb(0 0 0 / 0)); box-shadow: none;
    -webkit-backdrop-filter: none; backdrop-filter: none; /* a live blur over the moving sky cost half the frame rate */ }
  .hcard::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, rgb(255 255 255 / .18), rgb(255 255 255 / .1) 60%, rgb(255 255 255 / 0)); }
  /* A slow, faint shimmer passing across the sheet */
  .hcard::after { content: ''; position: absolute; top: -20%; bottom: -20%; left: 0; width: 45%; pointer-events: none; transform: translateX(-120%) skewX(-14deg);
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(214 204 255 / .07), rgb(255 255 255 / 0)); }
  .hcard > * { position: relative; z-index: 1; }
  .hcol .h-hero { margin: 0; }
  .hcol .lead { max-width: 520px; }
  .more { display: inline-flex; gap: 8px; margin-top: 24px; font: var(--text-body); color: var(--foreground); text-decoration: none; border-bottom: 1px solid rgb(255 255 255 / .24); padding-bottom: 2px; }
  .more:hover { border-color: var(--foreground); }
  .hcol .more { margin-top: 0; color: var(--muted-foreground); }
  .hform { display: grid; width: 100%; }
  .proof { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 8px; font: var(--text-small); font-size: 12px; color: var(--muted-foreground); }
  .proof li { display: flex; align-items: center; gap: 8px; }
  .spark { width: 4px; height: 4px; border-radius: 50%; background: #fff; flex: none;
    box-shadow: 0 0 4px 1px rgba(255,246,232,.9), 0 0 12px 3px rgba(232,201,140,.35); animation: spark 3.2s ease-in-out infinite; }
  .proof li:nth-child(2) .spark { animation-delay: -1.1s; }
  .proof li:nth-child(3) .spark { animation-delay: -2.2s; }
  @keyframes spark { 0%, 100% { opacity: .55; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.15); } }
  .app { overflow: hidden; }
  .agrid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .agrid > * { min-width: 0; }
  .phone { width: 300px; aspect-ratio: 430 / 932; border-radius: 44px; padding: 8px; background: #0b0b0b; border: 1px solid var(--glass-edge);
    box-shadow: var(--glass-highlight), 0 40px 120px rgba(0,0,0,.8); }
  .phone img { width: 100%; height: 100%; object-fit: cover; border-radius: 36px; }
  .phones { position: relative; width: 420px; max-width: 100%; aspect-ratio: 420 / 600; }
  .phones .phone { position: absolute; width: 260px; }
  .phones .back { left: 0; top: 0; transform: rotate(-4deg); opacity: .7; }
  .phones .front { right: 0; bottom: 0; transform: rotate(3deg); box-shadow: var(--glass-highlight), 0 40px 120px rgba(0,0,0,.9); }
  .acopy { display: grid; gap: 24px; justify-items: start; }
  .why .lead { max-width: 640px; }
  .why .label { color: var(--foreground); }
  .wgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .wcell { padding: 24px; display: grid; gap: 16px; align-content: start; }
  .wcell p { margin: 0; }
  .wcell canvas { width: 96px; height: 96px; margin: -16px 0 -8px -16px; }
  /* How it works = carousel of portrait cards, all the same size, swiped sideways (Nayara 26 Oct) */
  .steps { list-style: none; padding: 0 0 8px; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: min(340px, 78vw); gap: 16px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .steps::-webkit-scrollbar { display: none; }
  .steps li { aspect-ratio: 3 / 4.4; padding: 24px; display: grid; grid-template-rows: 1fr auto auto 5.6lh; gap: 12px; scroll-snap-align: start; }
  .steps p { margin: 0; }
  .slight { width: 220px; height: 220px; place-self: center; }
  .tint { border-radius: var(--radius-card); border: 1px solid rgb(var(--c) / .18); background: radial-gradient(130% 90% at 50% 0%, rgb(var(--c) / .12), transparent 62%), var(--glass-fill);
    box-shadow: var(--glass-highlight); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); }
  .pillars { overflow: hidden; }
  .pgrid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .plight { display: grid; place-items: center; }
  .plight canvas { width: 430px; height: 430px; max-width: 100%; }
  .pcopy { display: grid; gap: 24px; }
  .three { display: grid; gap: 16px; margin: 0; }
  .three div { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 8px; }
  .three dd { margin: 0; font: var(--text-body); color: var(--foreground); }
  .cgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .mcard { padding: 24px; display: grid; gap: 16px; text-decoration: none; align-content: start; }
  .mcard p { margin: 0; font: var(--text-body); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .badge { font: var(--text-label); text-transform: uppercase; letter-spacing: .08em; padding: 4px 8px; border-radius: 999px; border: 1px solid var(--glass-edge); background: var(--glass-fill); color: var(--foreground); }
  .center { text-align: center; margin-inline: auto; justify-items: center; }
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; font: var(--text-body); font-size: 15px; color: var(--foreground); }
  summary::-webkit-details-marker { display: none; }
  .chev { flex: none; color: var(--muted-foreground); transition: transform .3s; }
  details[open] .chev { transform: rotate(180deg); }
  details p { margin: 8px 0 0; }
  .final { overflow: hidden; padding-block: 160px; }
  .final::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse 40% 45% at 50% 55%, rgb(0 0 0 / .55), rgb(0 0 0 / 0)); }
  .final .narrow { position: relative; z-index: 1; display: grid; gap: 24px; }
  .fmoon { width: 140px; height: 140px; margin: 0 auto; }
  .fform { display: grid; justify-items: center; text-align: center; }
  .fform :global(.signup) { justify-content: center; margin-inline: auto; }
  /* What science says about rituals (Nayara 26 Oct): six findings, sources small at the end. Grid on desktop, swipe on mobile. */
  .stats { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .stat { padding: 24px; display: grid; grid-template-rows: auto 1fr auto; gap: 12px; }
  .stat p { margin: 0; }
  .stat .num { font: 400 40px/1.05 var(--font-serif); letter-spacing: -0.02em; color: var(--foreground); }
  .stat .num span { display: block; font-size: 17px; letter-spacing: 0; margin-top: 4px; color: var(--muted-foreground); }
