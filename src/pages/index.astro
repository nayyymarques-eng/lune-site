---
import Base from '../layouts/Base.astro';
import Ring from '../components/Ring.astro';
import Sky from '../components/Sky.astro';
import Stores from '../components/Stores.astro';
import Wordmark from '../components/Wordmark.astro';
import Signup from '../components/Signup.astro';
import moon from '../data/moon.json';
import R from '../data/readings.json';
import PhaseIcon from '../components/PhaseIcon.astro';
import { cap, fmtDate, utcOf, cycleAt } from '../lib/moon';
import { PRICE, CTA } from '../config';

const now = Date.now();
const big = (moon as any).phases.filter((p: any) => (p.kind === 'new_moon' || p.kind === 'full_moon') && utcOf(p.utc) > now).slice(0, 4).map((p: any) => {
  const ecl = (moon as any).eclipses.find((e: any) => Math.abs(utcOf(e.utc) - utcOf(p.utc)) < 864e5);
  const tag = ecl ? (ecl.kind === 'solar_eclipse' ? 'Solar eclipse' : 'Lunar eclipse') : p.kind === 'full_moon' && p.perigee_pct >= 90 ? 'Supermoon' : '';
  const s = (R.signs as any)[p.sign];
  return { ...p, tag, name: `${p.kind === 'new_moon' ? 'New' : 'Full'} moon in ${cap(p.sign)}`, text: p.kind === 'new_moon' ? s.new : s.full };
});

const faq = [
  ['Do I need to believe in astrology?', 'No. Lune reads the moon as a mirror, never as a prediction. The moon does nothing by itself: a phase is a moment, the sign a tone, the house an area of life. You bring the meaning.'],
  ['Is Lune religious?', 'Lune is spiritual, not religious. Practices come from many traditions, shown side by side as kin, never ranked. Believe what you choose.'],
  ['What do I need for a practice?', 'What you already have at home: a candle, a glass of water, paper and a pen. Tell Lune what you have and practices start from it. Fifteen minutes, often less.'],
  ['Do I need my birth time?', 'No. Without it, Lune counts your houses from your Sun sign. Add it whenever you like to see the moon in your own houses.'],
  ['Is the science real?', 'Every "What science says" cites a published study, with its limits said plainly. Where no study exists, we say so.'],
  ['How does the trial work?', `Premium is free for ${PRICE.trialDays} days. After that it is ${PRICE.month} a month or ${PRICE.year} a year, and you can cancel any time in your store settings. The free tier stays free.`],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'MobileApplication', name: 'Lune: Moon Rituals', operatingSystem: 'iOS, Android', applicationCategory: 'LifestyleApplication',
    offers: [{ '@type': 'Offer', price: '9.99', priceCurrency: 'USD' }, { '@type': 'Offer', price: '59.99', priceCurrency: 'USD' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base glow={false} description="A 15-minute ritual for every moon, with a candle, a glass of water or a pen. Lune gives you tonight's practice, timed to the moon. Free to start." schema={schema}>
  <section class="hero">
    <Sky />
    <div class="hleft">
      <div class="hmoonw">
        <canvas class="hmoon" data-light="moon" data-size="380" data-phase={cycleAt(moon as any).toFixed(3)} aria-hidden="true"></canvas>
        <script is:inline>document.currentScript.previousElementSibling.dataset.phase = (((Date.now() - 947182440000) / 2551442877) % 1).toFixed(3);</script>
        <div class="hmark"><Wordmark height={72} /></div>
      </div>
    </div>
    <div class="glass hcard hcol" id="start" data-solid><span id="waitlist" aria-hidden="true"></span>
      <h1 class="h-hero">{"A ritual for every moon".split(" ").map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{" "}</>)}</h1>
      <p class="lead">Fifteen minutes with a candle, a glass of water or a pen. Each night Lune gives you one practice timed to the moon above you, made from what you already have at home.</p>
      <div class="hform"><Signup source="hero" /></div>
      <Stores where="hero" />
      <a class="more" href="/tonight" data-cta="hero-tonight">Or see tonight's moon first <span aria-hidden="true">→</span></a>
      <ul class="proof">
        <li><span class="spark"></span>Practices timed to every moon through 2030</li>
        <li><span class="spark"></span>Gestures kept by traditions across the world</li>
        <li><span class="spark"></span>Every word with its source</li>
      </ul>
    </div>
  </section>

  <section class="why">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Why Lune</p>
        <h2 class="h-sec">An old rhythm for a tired, lit-up life</h2>
        <p class="lead">Our days run on screens. Lune uses the oldest clock we have, the moon, as a cue to put the phone down, light a candle and come back to yourself. Small, regular, yours.</p>
      </div>
      <div class="wgrid">
        <div class="glass wcell"><canvas data-light="mirror" data-size="64" data-color="179 166 242" aria-hidden="true"></canvas><h3 class="h-card">A mirror, never a prophecy</h3><p class="muted">The moon is a cue, not a forecast. It decides nothing; you bring the meaning.</p></div>
        <div class="glass wcell"><canvas data-light="twin" data-size="64" data-color="143 184 242" aria-hidden="true"></canvas><h3 class="h-card">Many traditions, as kin</h3><p class="muted">Each gesture shows where it comes from, beside the same gesture in another culture. Spiritual, not religious.</p></div>
        <div class="glass wcell"><canvas data-light="ripple" data-size="64" data-color="158 220 164" aria-hidden="true"></canvas><h3 class="h-card">Science, said gently</h3><p class="muted">What studies suggest, cited, with their limits. Where no study exists, we say so.</p></div>
        <div class="glass wcell"><canvas data-light="body" data-size="64" data-color="240 169 124" aria-hidden="true"></canvas><h3 class="h-card">Care before anything</h3><p class="muted">A practice is a moment of attention, not treatment. Nothing is ever aimed at another person's will.</p></div>
      </div>
    </div>
  </section>

  <section class="app">
    <div class="bg l2" style="--bgc: 179 166 242" aria-hidden="true"></div>
    <div class="wrap agrid">
      <Ring w={620} h={760} rx={0.47} ry={0.2} tilt={-16} n={560} speed={0.035}>
        <div class="phones">
          <div class="phone back"><img src="/brand/app-h1-today.webp" alt="The Lune app: tonight's moon, read for you" width="430" height="932" loading="lazy" /></div>
          <div class="phone front"><img src="/brand/app-p1-practice.webp" alt="A Lune practice: fifteen minutes, open, a few gestures, close" width="430" height="932" loading="lazy" /></div>
        </div>
      </Ring>
      <div class="acopy">
        <p class="label">Tonight, in the app</p>
        <h2 class="h-sec">Tonight's practice, ready when you are</h2>
        <p class="lead">Each evening Lune opens on the moon above you and one practice for it: open, a few gestures, close. Why tonight, where the gesture comes from and what science says sit one tap away.</p>
        <a class="btn secondary" href="/tonight" data-cta="app-tonight">See tonight's moon</a>
      </div>
    </div>
  </section>

  <section id="how" class="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">How it works</p>
        <h2 class="h-sec">Light it, live it, let it go</h2>
      </div>
      <ol class="steps">
        <li class="tint" style="--c: 179 166 242">
          <canvas class="slight" data-light="moon" data-size="120" data-r="0.4" data-phase="0.5" aria-hidden="true"></canvas>
          <span class="label">01 · Tonight's moon</span>
          <h3 class="h-card">One sentence for the night</h3>
          <p class="muted">What the night is good for, and what to go easy on. Plain, warm words.</p>
        </li>
        <li class="tint" style="--c: 240 169 124">
          <canvas class="slight" data-light="burst" data-size="120" data-r="0.4" data-color="240 169 124" aria-hidden="true"></canvas>
          <span class="label">02 · A practice to live it</span>
          <h3 class="h-card">Fifteen minutes, with a candle and a pen</h3>
          <p class="muted">Open, a few gestures, close. Choose love, work, health, prosperity, energy, gratitude, new paths or the divine.</p>
        </li>
        <li class="tint" style="--c: 143 184 242">
          <canvas class="slight" data-light="vortex" data-size="120" data-r="0.5" data-color="143 184 242" aria-hidden="true"></canvas>
          <span class="label">03 · Keep it</span>
          <h3 class="h-card">A quiet record of your moons</h3>
          <p class="muted">Each practice stays with you, so you can see what you planted at the new moon and what it became.</p>
        </li>
      </ol>
      <a class="more" href="#waitlist" data-cta="how-more">Get early access <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="pillars">
    <div class="bg l2" style="--bgc: 232 140 221" aria-hidden="true"></div>
    <div class="wrap pgrid">
      <div class="plight"><canvas data-light="galaxy" data-size="430" data-r="0.46" data-sparkle data-color="232 140 221" aria-hidden="true"></canvas></div>
      <div class="pcopy">
        <p class="label">Every practice, three ways to see it</p>
        <h2 class="h-sec">Every gesture, explained</h2>
        <dl class="three">
          <div><dt class="label">Yours</dt><dd>Why tonight, for you: the sign and house where the moon falls in your chart.</dd></div>
          <div><dt class="label">Where it comes from</dt><dd>The tradition behind the gesture, and the same gesture in another tradition, as kin.</dd></div>
          <div><dt class="label">What science says</dt><dd>What studies suggest, cited, with their limits said gently.</dd></div>
        </dl>
        <a class="more" href="/journal" data-cta="pillars-more">Read the journal <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="cal">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Coming up</p>
        <h2 class="h-sec">Plan two moons ahead</h2>
      </div>
      <div class="cgrid">
        {big.map((m: any, i: number) => (
          <a class="mcard tint" style={`--c: ${['179 166 242', '232 201 140', '143 184 242', '242 184 176'][i % 4]}`} href={`/moon/${m.sign}`}>
            <div class="row"><span class="label">{fmtDate(utcOf(m.utc))}</span>{m.tag && <span class="badge">{m.tag}</span>}</div>
            <PhaseIcon phase={m.kind} size={32} />
            <h3 class="h-card">{m.name}</h3>
            <p class="muted">{m.text}</p>
          </a>
        ))}
      </div>
      <a class="more" href="/moon" data-cta="cal-more">See the moon in every sign <span aria-hidden="true">→</span></a>
    </div>
  </section>


  <section id="pricing" class="pricing">
    <div class="bg l1" aria-hidden="true"></div>
    <div class="wrap">
      <div class="sec-head center">
        <p class="label">Pricing</p>
        <h2 class="h-sec">Free to start, Premium for every moon</h2>
      </div>
      <div class="prgrid">
        <div class="plan glass">
          <p class="label">Free</p>
          <p class="price">$0</p>
          <p class="muted">Always free, no card.</p>
          <ul class="feats">
            <li>The next four moons, with their dates</li>
            <li>A first look at tonight, behind a lock</li>
          </ul>
          <a class="btn secondary" href="#start" data-cta="pricing-free">{CTA}</a>
        </div>
        <div class="plan glass sel" data-plan>
          <div class="row"><p class="label">Premium</p>
            <div class="seg" role="tablist" aria-label="Billing">
              <button type="button" role="tab" data-p="month" aria-selected="false">Monthly</button>
              <button type="button" role="tab" data-p="year" class="on" aria-selected="true">Yearly</button>
            </div>
          </div>
          <p class="price"><span data-v="year">{PRICE.year}</span><span data-v="month" hidden>{PRICE.month}</span><span class="per"><span data-v="year"> / year</span><span data-v="month" hidden> / month</span></span></p>
          <p class="muted"><span data-v="year">{PRICE.yearPerMonth} a month, half the monthly price. </span>{PRICE.trialDays} days free, cancel any time.</p>
          <ul class="feats">
            <li>Tonight's moon, read for your sky</li>
            <li>Every practice, every night</li>
            <li>The full calendar, eclipses and supermoons</li>
            <li>Your altar: 163 items with history and science</li>
          </ul>
          <a class="btn primary" href="#start" data-cta="pricing-premium">{CTA}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="narrow">
      <div class="sec-head"><p class="label">Questions</p><h2 class="h-sec">Before you begin</h2></div>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}<svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="final">
    <Sky fade="both" />
    <div class="narrow center">
      <canvas class="fmoon" data-light="moon" data-size="140" data-phase="0.5" aria-hidden="true"></canvas>
      <h2 class="h-sec">The next moon is already on its way</h2>
      <p class="lead">Be there when it arrives.</p>
      <div class="fform"><Signup source="final" /></div>
    </div>
  </section>
</Base>

<style>
  section { position: relative; }
  /* Hero (Nayara 26 Oct): desktop = moon and logo on the sky at left, full-height glass panel at right;
     mobile = moon with the logo inside it, the card rising over its lower half. */
  .hero { position: relative; min-height: min(100svh - 65px, 920px); display: grid; grid-template-columns: 1fr minmax(460px, 44%); align-items: stretch; padding: 0; overflow: hidden; }
  .hleft { position: relative; z-index: 1; display: grid; place-items: center; padding: 64px 24px; }
  .hmoonw { position: relative; display: grid; justify-items: center; gap: 24px; }
  .hmoon { width: 380px; height: 380px; display: block; }
  .hmark { display: grid; justify-items: center; }
  .hcard { position: relative; z-index: 2; box-sizing: border-box; min-width: 0; display: grid; gap: 20px; align-content: center; justify-items: start; padding: 72px clamp(32px, 5vw, 72px); border: 0; border-radius: 0; overflow: hidden;
    /* Tinted sheet that melts into the next section at the bottom; a hairline on its left edge fades the same way. */
    background: linear-gradient(to bottom, rgb(22 22 28 / .9), rgb(16 16 20 / .9) 72%, rgb(0 0 0 / 0)); box-shadow: none;
    -webkit-backdrop-filter: none; backdrop-filter: none; /* a live blur over the moving sky cost half the frame rate */ }
  .hcard::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, rgb(255 255 255 / .18), rgb(255 255 255 / .1) 60%, rgb(255 255 255 / 0)); }
  /* A slow, faint shimmer passing across the sheet */
  .hcard::after { content: ''; position: absolute; top: -20%; bottom: -20%; left: 0; width: 45%; pointer-events: none; transform: translateX(-120%) skewX(-14deg);
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(214 204 255 / .07), rgb(255 255 255 / 0)); }
  .hcard > * { position: relative; z-index: 1; }
  .hcol .h-hero { margin: 0; }
  .hcol .lead { max-width: 520px; }
  .more { display: inline-flex; gap: 8px; margin-top: 24px; font: var(--text-body); color: var(--foreground); text-decoration: none; border-bottom: 1px solid rgb(255 255 255 / .24); padding-bottom: 2px; }
  .more:hover { border-color: var(--foreground); }
  .hcol .more { margin-top: 0; color: var(--muted-foreground); }
  .hform { display: grid; width: 100%; }
  .proof { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 8px; font: var(--text-small); font-size: 12px; color: var(--muted-foreground); }
  .chev { flex: none; color: var(--muted-foreground); transition: transform .3s; }
  details[open] .chev { transform: rotate(180deg); }
  details p { margin: 8px 0 0; }
  .final { overflow: hidden; padding-block: 160px; }
  .final::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse 40% 45% at 50% 55%, rgb(0 0 0 / .55), rgb(0 0 0 / 0)); }
  .final .narrow { position: relative; z-index: 1; display: grid; gap: 24px; }
  .fmoon { width: 140px; height: 140px; margin: 0 auto; }
  .fform { display: grid; justify-items: center; }
  @media (max-width: 900px) {
    .pgrid, .agrid { grid-template-columns: 1fr; }
    .wgrid { grid-template-columns: 1fr 1fr; }
    .phone { width: 240px; }
    .phones { width: 340px; }
    .phones .phone { width: 200px; border-radius: 32px; }
    .hero { grid-template-columns: 1fr; min-height: 0; padding: 32px 0 64px; }
    .hleft { padding: 0; }
    .hmoon { width: min(380px, 100vw - 16px); height: min(380px, 100vw - 16px); }
    .hmark { position: absolute; inset: 0; place-items: center; align-content: center; }
    .hmark :global(img) { height: 56px !important; }
    .hcard { width: min(640px, 100% - 32px); margin: -110px auto 0; padding: 32px 20px 24px; border: 1px solid var(--glass-edge); border-radius: 16px; background: rgb(20 20 26 / .86); box-shadow: var(--glass-highlight); }
    .hcard::before { display: none; }
    .steps, .prgrid { grid-template-columns: 1fr; }
    .cgrid { grid-template-columns: 1fr 1fr; }
    .plan.sel { order: -1; }
  }
  @media (max-width: 560px) { .cgrid, .wgrid { grid-template-columns: 1fr; } }
  /* Entrance, after the app opening: the moon gathers from far back, the ring and card follow, words come out of blur */
  @media (prefers-reduced-motion: no-preference) {
    /* The sheet slides in from the right (transform only, so it stays smooth), then the words arrive. */
    .hcard { animation: in-sheet 1.3s .5s both cubic-bezier(.22,1,.36,1); }
    .hcard::after { animation: shimmer 9s 2.2s infinite cubic-bezier(.45,0,.35,1); }
    .hcard .w { display: inline-block; animation: in-word .9s both cubic-bezier(.2,.8,.2,1); animation-delay: calc(1.1s + var(--i) * .08s); }
    .hcard > :not(h1) { animation: in-fade 1s 1.6s both ease-out; }
    @media (max-width: 900px) { .hcard { animation: in-up 1.1s .5s both cubic-bezier(.22,1,.36,1); } }
    .proof { animation: in-fade 1.4s 2.6s both ease-out; }
  }
  @keyframes in-fade { from { opacity: 0; } }
  @keyframes in-sheet { from { transform: translateX(100%); } }
  @keyframes in-up { from { opacity: 0; transform: translateY(32px); } }
  @keyframes in-word { from { opacity: 0; transform: translateX(16px); } }
  @keyframes shimmer { 0% { transform: translateX(-120%) skewX(-14deg); } 40%, 100% { transform: translateX(320%) skewX(-14deg); } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-plan]').forEach((card) => {
    card.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) => b.addEventListener('click', () => {
      const p = b.dataset.p!;
      card.querySelectorAll('.seg button').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
      card.querySelectorAll<HTMLElement>('[data-v]').forEach((el) => (el.hidden = el.dataset.v !== p));
    }));
  });
</script>
