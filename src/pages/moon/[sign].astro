---
// One page per sign: "The moon in Aries". Made for search and for the per-sign pins on Pinterest.
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import moon from '../../data/moon.json';
import R from '../../data/readings.json';
import { SIGNS, SIGN_GLYPH, visitsOf, lunationsIn, fmtDate, utcOf } from '../../lib/moon';

export function getStaticPaths() { return SIGNS.map((sign) => ({ params: { sign } })); }
const { sign } = Astro.params as { sign: string };
const S = (R.signs as any)[sign];
const visits = visitsOf(moon as any, sign, Date.now(), 4);
const lun = lunationsIn(moon as any, sign);
// The next new and full moon in this sign, shown on their cards so each reading has its date.
const when = (kind: string) => {
  const p: any = lun.find((x: any) => x.kind === kind);
  return p && `${fmtDate(utcOf(p.utc))}, ${new Date(utcOf(p.utc)).getUTCFullYear()}`;
};
const nextNew = when('new_moon');
const nextFull = when('full_moon');
const title = `The moon in ${S.name}`;
const desc = `When the moon is in ${S.name}, the night carries ${S.tone}. Next dates and the new and full moon in ${S.name}.`;
---
<Base title={title} description={desc} type="article">
  <article class="narrow page">
    <p class="label"><a href="/moon">Moon in your sign</a> · {SIGN_GLYPH[sign]} {S.name}</p>
    <h1 class="h-sec">{title}</h1>
    <p class="lead">Every two and a half days the moon moves into a new sign. In {S.name}, the night carries {S.tone}. Here is how to live it.</p>

    <div class="live glass" data-sign={sign} hidden>
      <span class="dot"></span>
      <p>Tonight the moon is in {S.name}. If it's your sign, this is your night: <a href="#next">see the next dates</a>.</p>
    </div>

    <div class="pgrid">
      <div class="pcard glass">
        <canvas class="plight" data-light="burst" data-size="88" data-r="0.46" data-color="179 166 242" aria-hidden="true"></canvas>
        <p class="label">At the new moon</p>
        {nextNew && <p class="when">Next new moon in {S.name} · {nextNew}</p>}
        <p class="reading">{S.new}</p>
      </div>
      <div class="pcard glass">
        <canvas class="plight" data-light="moon" data-size="88" data-r="0.42" data-phase="0.5" aria-hidden="true"></canvas>
        <p class="label">At the full moon</p>
        {nextFull && <p class="when">Next full moon in {S.name} · {nextFull}</p>}
        <p class="reading">{S.full}</p>
      </div>
    </div>
    <div class="share">
      <button type="button" class="btn secondary sm" data-share data-title={`The moon in ${S.name} · Lune`} data-text={`The moon in ${S.name}: what it asks of the night, and the next dates.`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>
        Share with a friend
      </button>
      <span class="small muted" data-shared hidden role="status">Link copied</span>
    </div>

    <h2 id="next">Next moons in {S.name}</h2>
    <ul class="dates">
      {visits.map((v) => <li><span>{fmtDate(v.start)} to {fmtDate(v.end)}</span><span class="label">about {Math.round((v.end - v.start) / 36e5)} hours</span></li>)}
    </ul>
    <p class="small muted">Dates in UTC. The app times every moon to your city.</p>

    <div class="cta glass">
      <h2>Tonight's practice, timed to this moon</h2>
      <p class="muted">Fifteen minutes with a candle and a pen, made from what you have at home.</p>
      <Signup source={`sign-${sign}`} />
    </div>

    <details class="origin">
      <summary>Where reading the moon by sign comes from</summary>
      <p class="muted">{R.origin.text.replace(/[¹²³]/g, '')}.</p>
    </details>
  </article>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const data = { title: b.dataset.title, text: b.dataset.text, url: location.href };
    try {
      if (navigator.share) { await navigator.share(data); return; }
      await navigator.clipboard.writeText(location.href);
      const ok = b.parentElement!.querySelector<HTMLElement>('[data-shared]')!; ok.hidden = false; setTimeout(() => (ok.hidden = true), 2500);
    } catch {}
  }));
</script>
<style>
  .page { padding-block: 64px; display: grid; gap: 20px; }
  .page h2 { font: var(--text-title); letter-spacing: -0.035em; margin-top: 32px; }
  .page p { margin: 0; }
  .label a { text-decoration: none; }
  .when { font: var(--text-small); color: var(--foreground); }
  .reading { font-family: var(--font-sans); font-size: 18px; line-height: 1.5; color: var(--foreground); }
  .dates { list-style: none; margin: 0; padding: 0; }
  .dates li { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--line); font-family: var(--font-sans); font-size: 16px; color: var(--foreground); }
  .share { display: flex; align-items: center; gap: 12px; }
  .share .btn { display: inline-flex; align-items: center; gap: 8px; }
  .live { display: flex; gap: 16px; align-items: center; padding: 16px 20px; }
  .live[hidden] { display: none; }
  .cta { padding: 24px; display: grid; gap: 16px; margin-top: 32px; }
  .cta h2 { margin: 0; }
  .pgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
  .pcard { padding: 24px; display: grid; gap: 12px; align-content: start; }
  .plight { width: 88px; height: 88px; margin: -12px 0 0 -12px; }
  .origin { margin-top: 32px; border-top: 1px solid var(--line); padding-top: 16px; }
  .origin summary { cursor: pointer; font: var(--text-small); color: var(--foreground); }
  .origin p { margin-top: 12px; font-family: var(--font-sans); font-size: 16px; line-height: 1.5; }
  @media (max-width: 640px) { .pgrid { grid-template-columns: 1fr; } }
</style>
<script>
  import moon from '../../data/moon.json';
  import { signAt } from '../../lib/moon';
  const el = document.querySelector('.live') as HTMLElement;
  if (el && signAt(moon as any).sign === el.dataset.sign) el.hidden = false;
</script>
